---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Joseph K Anoj — Full Stack Developer · Frontend Specialist',
  description = 'Full Stack Developer and Frontend Specialist building fast, accessible, responsive interfaces in React and Astro. Open to remote work and relocation.',
} = Astro.props;

// Structured data for search engines — only facts already on the page.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Joseph K Anoj',
  url: 'https://josephk.dev/',
  // The real photo, which is deliberately not shown anywhere on the page
  // (the hero draws the particle portrait instead). Naming it here and in
  // sitemap.xml is how search engines learn it is a picture of this person.
  image: 'https://josephk.dev/images/Joseph-img.jpg',
  jobTitle: 'Full Stack Developer',
  description,
  address: { '@type': 'PostalAddress', addressCountry: 'IN' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Sahrdaya College of Engineering and Technology' },
  knowsAbout: ['React', 'Next.js', 'Astro', 'TypeScript', 'JavaScript', 'Node.js', 'Frontend engineering', 'Web accessibility'],
  sameAs: ['https://github.com/JosuK22', 'https://linkedin.com/in/joseph-k-anoj'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Joseph K Anoj" />
    <meta name="theme-color" content="#0A0E0A" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://josephk.dev/" />

    <!-- Open Graph. og:image must be an absolute URL — relative paths are
         silently dropped by most scrapers. Regenerate the card from
         resume/../ og source if the name or title ever changes. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://josephk.dev/" />
    <meta property="og:image" content="https://josephk.dev/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Joseph K Anoj — Frontend Developer" />
    <meta property="og:site_name" content="Joseph K Anoj" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter/X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://josephk.dev/og.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=VT323&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />

    <!-- Boot-sequence flag. Runs before first paint so the intro never
         flashes; skipped entirely under prefers-reduced-motion, and a
         failsafe reveals the page even if the typing script never runs. -->
    <script is:inline>
      (function () {
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var root = document.documentElement;
        // A link straight to a section (josephk.dev/#projects) should land
        // there, not sit through the intro at the top of the page.
        if (location.hash && location.hash !== '#top') return;
        root.classList.add('booting');
        setTimeout(function () {
          if (root.classList.contains('booting')) {
            root.classList.remove('booting');
            root.classList.add('booted');
          }
        }, 5000);
      })();
    </script>
  </head>
  <body>
    <!--
      ╔══════════════════════════════════════════════════╗
      ║  reading the source, are we? three games hide     ║
      ║  on this page. three riddles:                     ║
      ║   · it grows as it eats — type its name           ║
      ║   · the project lights rehearse their secret      ║
      ║   · the code that gave 30 lives still works       ║
      ╚══════════════════════════════════════════════════╝
    -->
    <a class="skip-link" href="#about">Skip to content</a>
    <noscript>
      <style>
        /* the sfx switch and the shell both need JS — don't offer dead keys */
        [data-sound-toggle], [data-term-open] { display: none !important; }
      </style>
    </noscript>
    <div class="scanlines" aria-hidden="true"></div>
    <slot />

    <script>
      const CLICKABLE_SELECTOR = "a, button, [role='button'], input[type='submit'], input[type='button'], label[for]";

      function createPool(src: string, size: number, volume: number) {
        return Array.from({ length: size }, () => {
          const audio = new Audio(src);
          audio.volume = volume;
          audio.preload = 'auto';
          return audio;
        });
      }

      function playFromPool(pool: HTMLAudioElement[], index: { i: number }) {
        const audio = pool[index.i];
        index.i = (index.i + 1) % pool.length;
        audio.currentTime = 0;
        audio.play().catch(() => {});
      }

      // ---- the sfx switch (nav) --------------------------------------
      // On by default — the clicks are part of the machine — but one key
      // turns them off, and the choice is remembered. <html data-sound>
      // is the single source of truth; Contact.astro reads it too.
      const SOUND_KEY = 'jk-sound';
      const root = document.documentElement;
      const toggles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-sound-toggle]'));
      const readSound = () => {
        try {
          return localStorage.getItem(SOUND_KEY) !== 'off';
        } catch {
          return true;
        }
      };
      const applySound = (on: boolean) => {
        root.dataset.sound = on ? 'on' : 'off';
        toggles.forEach((t) => {
          t.setAttribute('aria-pressed', String(on));
          t.setAttribute('aria-label', on ? 'Interface sounds on — turn off' : 'Interface sounds off — turn on');
          const state = t.querySelector('[data-sound-state]');
          if (state) state.textContent = on ? 'on' : 'off';
        });
      };
      applySound(readSound());
      toggles.forEach((t) =>
        t.addEventListener('click', () => {
          const on = root.dataset.sound === 'off';
          applySound(on);
          try {
            localStorage.setItem(SOUND_KEY, on ? 'on' : 'off');
          } catch {
            /* private mode: the switch still works for this visit */
          }
        })
      );

      // The pool is built on the first click that needs it, so a visitor
      // with sound off never downloads the file at all.
      let clickPool: HTMLAudioElement[] | null = null;
      const clickIndex = { i: 0 };

      document.addEventListener('click', (e) => {
        const target = e.target;
        if (!(target instanceof Element)) return;
        const match = target.closest(CLICKABLE_SELECTOR) as (HTMLElement & { disabled?: boolean }) | null;
        if (!match || match.disabled) return;
        // Turning sound on confirms itself with a click; turning it off is silent.
        if (root.dataset.sound === 'off') return;
        clickPool ??= createPool('/sounds/menu-click.mp3', 4, 0.5);
        playFromPool(clickPool, clickIndex);
      });
    </script>

    <script>
      import { initSecrets } from '../scripts/secrets';
      import { initTerminal } from '../scripts/terminal';
      initSecrets();
      initTerminal();

      // Reveal-on-scroll: sections below the fold fade up as they enter the
      // viewport. Elements already visible on load are never hidden (no
      // flash), and the whole thing is skipped under prefers-reduced-motion
      // — the class is only ever added by JS, so no-JS visitors see
      // everything as normal too.
      if (
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
        'IntersectionObserver' in window
      ) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal--in');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.06 }
        );
        document.querySelectorAll('.section .wrap').forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight * 0.94) return;
          el.classList.add('reveal');
          io.observe(el);
        });
      }
    </script>
  </body>
</html>
